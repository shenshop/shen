{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shen",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "shen" }],
  "images": { "binding": "IMAGES" },
  // Сховища KV у Cloudflare: shen-page-cache і shen-tag-cache.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "d2cb38192df84445bda4123c0e8b341a" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "b554a1b707e54a2aba5d3964366976aa" }
  ],
  // Номери з KeyCRM: джерело «Сайт 2», служби доставки «НП» та «Укрпошта ФОП».
  // Ключ KEYCRM_API_KEY зберігається як секрет у Cloudflare, не тут.
  "vars": {
    "KEYCRM_SOURCE_ID": "13",
    "KEYCRM_NOVAPOSHTA_ID": "4",
    "KEYCRM_UKRPOSHTA_ID": "3",
    // Куди бот шле сповіщення про замовлення (Id Дрона з @userinfobot). Ключ бота — секрет TELEGRAM_BOT_TOKEN у Cloudflare.
    "TELEGRAM_CHAT_ID": "413905782"
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
