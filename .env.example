# KeyCRM: Налаштування → API → створити ключ
KEYCRM_API_KEY=
# ID джерела замовлень «Сайт» у KeyCRM (GET /order/source)
KEYCRM_SOURCE_ID=
# ID служб доставки у KeyCRM (GET /order/delivery-service)
KEYCRM_NOVAPOSHTA_ID=
KEYCRM_UKRPOSHTA_ID=

# Нова Пошта: особистий кабінет → Налаштування → Безпека → API ключ
NOVAPOSHTA_API_KEY=

# Facebook Pixel ID (Events Manager)
NEXT_PUBLIC_FB_PIXEL_ID=

# Секрет для миттєвого оновлення каталогу: /api/revalidate?secret=...
REVALIDATE_SECRET=

# Контакти магазину
NEXT_PUBLIC_PHONE=+380738113785
